# ============ 使用说明 ============
# 复制本文件为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交到仓库。
#   cp .env.example .env
# 需要 API Key：https://platform.deepseek.com/api_keys

# 数据库配置（相对路径会落到 Flask 的 instance/ 目录）
DATABASE_URL=sqlite:///./learning_assistant.db

# 邮箱配置（保持占位值时系统会自动跳过真实发信，适合演示）
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your_email@example.com

# 应用配置
SECRET_KEY=change-me-to-a-random-string
DEBUG=True

# AI 服务配置（DeepSeek API）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：disabled 更快更便宜（演示推荐）；enabled 可展示推理过程
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_TIMEOUT=60

# 知识库检索索引路径（留空使用 backend/bm25_index/index.json）
# BM25_INDEX_PATH=

# 「教师权威答案」词法匹配阈值（0~1，越大越严格）
AUTHORITATIVE_SIM_THRESHOLD=0.45

# Agent（深度模式）配置
AGENT_MAX_ROUNDS=6
AGENT_TIMEOUT_SECONDS=50
AGENT_MAX_OUTPUT_TOKENS=2048
